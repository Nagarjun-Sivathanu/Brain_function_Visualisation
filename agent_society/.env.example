# Brain Region Society — configuration
#
# Every agent runs on ONE shared OpenAI-compatible LLM endpoint. No provider
# API key is required; the lab endpoint uses an empty key.

LLM_BASE_URL=http://dgx5.humanbrain.in:8999/v1
LLM_API_KEY=empty
LLM_MODEL=Llama-3.3-70B-Instruct

# Optional: path to the repo root that holds the region folders (Brain/, …).
# Defaults to the parent of agent_society/, which is correct in this repo.
# BRAIN_REGION_ROOT=C:\Users\you\Documents\Brain_region

# Optional: surface internal hiccups (model fallback notes) in chat.
# AAS_DEV_MODE=1
